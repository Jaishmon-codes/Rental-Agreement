# ==============================================================================
# RentSphere Backend Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to `backend/.env` for backend configuration.
# In production, NEVER commit real credentials to source control.
# ==============================================================================

NODE_ENV=development
PORT=4000
TRUST_PROXY=1
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# In production, JWT_SECRET must be at least 32 characters generated via crypto: `openssl rand -hex 32`
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_random_key_in_production
JWT_EXPIRY=24h

DB_PATH=./rental_database.sqlite
ALLOW_DEMO_SEED=false

# Razorpay Test Configuration (Do NOT commit real production credentials)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder
RAZORPAY_LIVE=false
PLATFORM_FEE_PERCENTAGE=0.03

# Web3 & Blockchain (Sepolia or Localhost)
WEB3_RPC_URL=http://127.0.0.1:8545
MIN_WEB3_CONFIRMATIONS=1

# Queue & Worker
QUEUE_ADAPTER=sqlite
WORKER_INTERVAL_MS=5000

# Document Storage
DOCUMENT_STORAGE_DIR=./uploads
